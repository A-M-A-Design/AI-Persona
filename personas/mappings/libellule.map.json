{
  "$comment": "Libellule — geek, rétro 16-bit : cyan/magenta saturés, coins durs, ombres arcade sans flou, typo pixel (display) et terminal (body).",
  "colors": {
    "hueRules": [
      { "from": [195, 270], "to": 187, "saturate": 1.4, "spread": 0.2 },
      { "from": [270, 340], "to": 315, "saturate": 1.35 },
      { "maxSat": 0.1, "tintHue": 200, "tintSat": 0.06 }
    ],
    "saturateAll": 1.12
  },
  "fonts": {
    "Montserrat": "var(--font-libellule-display)",
    "Unna": "var(--font-libellule-display)",
    "Roboto": "var(--font-libellule-body)"
  },
  "vars": {
    "--ama-sem-border-radius-*": "0",
    "--ama-comp-checkbox-radius": "0",
    "--ama-comp-map-pointer-radius": "0",
    "--ama-comp-booking-engine-radius": "0",
    "--ama-sem-number-shadow-blur": "0",
    "--ama-sem-number-shadow-wide-blur": "0",
    "--ama-sem-number-shadow-up-y": "4px",
    "--ama-sem-number-shadow-down-y": "4px",
    "--ama-sem-number-shadow-down-wide-y": "6px",
    "--ama-sem-font-sizes-body-md": "1.2rem",
    "--ama-sem-font-sizes-input-md": "1.2rem",
    "--ama-sem-font-sizes-display-sm": "1.4rem",
    "--ama-sem-font-sizes-display-md": "1rem",
    "--ama-sem-line-heights-display-md": "1.5rem",
    "--ama-sem-font-sizes-subtitle-lg": "1rem",
    "--ama-sem-line-heights-subtitle-lg": "1.5rem"
  },
  "$commentVarsByBreakpoint": "Press Start 2P occupe environ deux fois la largeur d'une grotesque à taille égale : à 38 px le titre du héro passait à 3 lignes sur mobile contre 2 pour les autres avatars, et son accroche à 4 lignes à 320 px. Ces valeurs alignent la hauteur du bloc sur celle des autres — pas le nombre de lignes, qui n'est pas la bonne mesure. Aux autres largeurs la taille commune tient, et rien n'y est touché.",
  "varsByBreakpoint": {
    "mobile": {
      "--ama-sem-font-sizes-display-2xl": "1.5rem",
      "--ama-sem-line-heights-display-2xl": "2rem",
      "--ama-sem-font-sizes-display-sm": "0.875rem",
      "--ama-sem-line-heights-display-sm": "1.25rem"
    }
  }
}
