# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est JAMAIS commité.

# Provider du chat : mistral (défaut) ou anthropic.
CHAT_PROVIDER=mistral

# --- mistral -----------------------------------------------------------
# Clé API Mistral — https://console.mistral.ai
# Le tier Experiment est gratuit (~1 Md tokens/mois) mais impose l'opt-in
# à l'entraînement : ce qui transite alimente les modèles de Mistral.
MISTRAL_API_KEY=
# Modèle (défaut si absent : mistral-medium-latest)
# CHAT_MODEL=mistral-medium-latest

# --- anthropic ---------------------------------------------------------
# Clé API Anthropic — https://console.anthropic.com (format sk-ant-api03-...)
# Seul provider à cacher le prefix stable du prompt (~90 % d'économie
# d'input dès la 2e requête).
# ANTHROPIC_API_KEY=sk-ant-api03-...
# Modèle (défaut si absent : claude-haiku-4-5, $1/$5 par MTok)
# CHAT_MODEL=claude-haiku-4-5

# (optionnel) Chemin du zip WDS si absent de la racine du projet
# WELDS_ZIP=C:\chemin\vers\welds-mcp-v3.zip
