# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est JAMAIS commité.

# Provider du chat : mistral (défaut) ou anthropic.
CHAT_PROVIDER=mistral

# --- mistral -----------------------------------------------------------
# Clé API Mistral — https://console.mistral.ai
# Le tier Experiment est gratuit (~1 Md tokens/mois) mais impose l'opt-in
# à l'entraînement : ce qui transite alimente les modèles de Mistral.
MISTRAL_API_KEY=
# Modèle (défaut si absent : mistral-medium-latest)
# CHAT_MODEL=mistral-medium-latest

# --- anthropic ---------------------------------------------------------
# Clé API Anthropic — https://console.anthropic.com (format sk-ant-api03-...)
# Seul provider à cacher le prefix stable du prompt (~90 % d'économie
# d'input dès la 2e requête).
# ANTHROPIC_API_KEY=sk-ant-api03-...
# Modèle (défaut si absent : claude-haiku-4-5, $1/$5 par MTok)
# CHAT_MODEL=claude-haiku-4-5

# (optionnel) Chemin du zip WDS si absent de la racine du projet
# WELDS_ZIP=C:\chemin\vers\welds-mcp-v3.zip

# --- limite de débit ------------------------------------------------------
# /api/chat appelle un modèle payant avec NOTRE clé : sans limite, un script
# consomme le quota en quelques minutes.
#
# Sans les deux variables ci-dessous, le repli en mémoire prend le relais. Il
# suffit en développement et NE PROTÈGE PAS en production : sur une plateforme
# sans serveur, chaque instance a son propre compteur et elles sont éphémères.
# Créer une base sur https://console.upstash.com (Redis, formule gratuite) et
# coller les deux valeurs « REST » de sa page de détail.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Réglables sans redéploiement de code. Défauts : 30 questions par jour et par
# adresse IP, et 5 par minute — ce second seuil est un garde-fou, pas un
# plafond d'usage : sans lui, une seule adresse épuise en trois secondes le
# quota Mistral du compte, qui plafonne à ~2 réponses par minute.
# RATE_LIMIT_PAR_JOUR=30
# RATE_LIMIT_PAR_MINUTE=5
